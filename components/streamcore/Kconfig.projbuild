        orsource "../sc_webstream/Kconfig.sc32"
        orsource "../sc_sdfile/Kconfig.sc32"
        orsource "../sc_dlna/Kconfig.sc32"
    endmenu

    menu "Hardware"
        orsource "../bell/Kconfig.sc32"
        orsource "../sc_sdcard/Kconfig.sc32"
        orsource "../i2c_bus/Kconfig.sc32"
        orsource "../gdey027t91/Kconfig.sc32"
        orsource "../ft6x36/Kconfig.sc32"
        orsource "../bq27220/Kconfig.sc32"
        orsource "../sc_app/Kconfig.led"
    endmenu

endmenu
